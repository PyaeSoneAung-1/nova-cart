# ── NovaCart Backend Environment Variables ──────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL) — these defaults match docker-compose.yml (`docker compose up -d db`)
DATABASE_URL="postgresql://novacart:novacart_dev_password@localhost:5432/novacart?schema=public"
# Direct (non-pooled) connection used by `prisma migrate` — same as
# DATABASE_URL locally; on Neon use the direct (non-pooler) connection string.
DIRECT_URL="postgresql://novacart:novacart_dev_password@localhost:5432/novacart?schema=public"
# Used by tests — must be a DIFFERENT database from the dev one.
DATABASE_URL_TEST="postgresql://novacart:novacart_dev_password@localhost:5432/novacart_test?schema=public"

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

# Cookie options
COOKIE_SECURE=false

# Shipping
SHIPPING_FEE=5
FREE_SHIPPING_THRESHOLD=50

# Mock email delivery — when true, password-reset codes/tokens are returned
# in the API response instead of being sent by email (dev/demo only).
MOCK_EMAIL=true
